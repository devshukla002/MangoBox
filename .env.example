# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins (e.g. http://localhost:3000,http://127.0.0.1:3000,https://your-app.onrender.com)
ALLOWED_ORIGINS="MY_ALLOWED_ORIGINS"

# DATABASE_URL: Standard PostgreSQL connection URL
DATABASE_URL= postgresql://postgres:mangobox%402026@db.wlxqkbceigjrmczvttoq.supabase.co:5432/postgres

# JWT_SECRET: Private sign key used to issue session authorization tokens
JWT_SECRET=YOUR_JWT_SECRET

# CLOUDINARY_URL: Credentials for hosting media files (e.g. cloudinary://api_key:api_secret@cloud_name)
CLOUDINARY_URL=YOUR_CLOUDINARY_URL

# RESEND_API_KEY: Credentials for delivering user inquiries to administrative emails (e.g. re_abc123)
RESEND_API_KEY=YOUR_RESEND_API_KEY

# GOOGLE_CLIENT_ID: Firebase Client Google Authentication Client ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# GOOGLE_CLIENT_SECRET: Firebase Client Google Authentication Client Secret
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ADMIN_EMAIL: Configurable administrative login email
ADMIN_EMAIL=YOUR_ADMIN_EMAIL

# ADMIN_PASSWORD: Configurable administrative login password
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
